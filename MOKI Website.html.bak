<section class="view" id="projects"><div class="pg">
  <h2>PROJECTS</h2>
  <div class="cards" id="cards"></div>
</div></section>

<section class="view" id="licensing"><div class="pg">
  <h2>LICENSING</h2>
  <p style="max-width:560px;margin-top:6px">Free access first. Every MOKI product ships with its own clear license, shown on its project page.</p>
  <div class="lic">
    <div><b>Personal use</b><br>Each product page states whether it is allowed.</div>
    <div><b>Commercial use</b><br>Decided and stated per product.</div>
    <div><b>Modification and redistribution</b><br>Rules are listed on every download page.</div>
    <div><b>Attribution</b><br>Mandatory or optional, set per product, always with a MOKI creator credit.</div>
  </div>
</div></section>
</main>

<footer><span>MOKI © 2026</span><span>Made with love and zero budget</span></footer>

<dialog id="dlg"></dialog>

<script>
var P=[
{n:"MOKI Mascot",c:"Illustration",bg:"#FDAEC7",d:"The mischievous pastel monster behind the brand.",o:"Give MOKI a face people remember.",f:"Vector mascot, animated intro, sticker-ready poses",live:1},
{n:"Pastel UI Kit",c:"UI/UX",bg:"#91D1FD",d:"Soft, rounded interface components for apps and sites.",o:"A friendly, reusable design system.",f:"Buttons, cards, forms, nav patterns"},
{n:"Sticker Pack 01",c:"Stickers",bg:"#FED967",d:"Chunky outlined stickers in the MOKI palette.",o:"Cute assets anyone can drop into their work.",f:"Print and digital sizes"},
{n:"Poster Series",c:"Posters",bg:"#FEF3D3",d:"Bold, colourful posters and social graphics.",o:"Visuals that stop the scroll.",f:"Poster, banner and story formats"},
{n:"Widget Pack",c:"Components",bg:"#FC6B8B",d:"Reusable website widgets, ready to copy.",o:"Save builders hours.",f:"Cards, hero blocks, creator credit"},
{n:"Book Cover Set",c:"Book Covers",bg:"#91D1FD",d:"Illustrated cover designs for indie authors.",o:"Stories deserve a good first look.",f:"Front covers with editable layouts"}];
var cnt=0,$=function(i){return document.getElementById(i)};
$("cards").innerHTML=P.map(function(p,i){return '<article class="card"><div class="tile" style="background:'+p.bg+'">'+p.n.split(" ")[0]+'</div><div class="cb"><span class="chip">'+p.c+(p.live?'':' · soon')+'</span><h3>'+p.n+'</h3><p>'+p.d+'</p><button class="btn" data-i="'+i+'">View project</button></div></article>'}).join("");
$("cards").onclick=function(e){var b=e.target.closest("[data-i]");if(!b)return;var p=P[b.dataset.i],d=$("dlg");
d.innerHTML='<span class="chip">'+p.c+'</span><h3>'+p.n+'</h3><p>'+p.d+'</p><dl><dt>Design objective</dt><dd>'+p.o+'</dd><dt>Highlights</dt><dd>'+p.f+'</dd><dt>Credit</dt><dd>Created by MOKI</dd><dt>License</dt><dd>'+(p.live?'Stated on the download page.':'Announced at release.')+'</dd></dl><div class="row">'+(p.live?'<button class="btn" id="get">Get it free</button>':'')+'<button class="btn" id="cl" style="background:var(--card)">Close</button></div>';
d.showModal();$("cl").onclick=function(){d.close()};if(p.live)$("get").onclick=function(){$("cnt").textContent=++cnt;d.close()}};
$("nav").onclick=function(e){var b=e.target.closest("button");if(!b)return;[].forEach.call(document.querySelectorAll("nav button,.view"),function(x){x.classList.remove("on")});b.classList.add("on");$(b.dataset.v).classList.add("on");scrollTo(0,0)};
$("dlg").onclick=function(e){if(e.target===this)this.close()};
</script>
</body>
</html>
