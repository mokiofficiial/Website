<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MOKI — Design, but cute</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Syne:wght@600;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#1F0B0B;--bg:#fff;--fg:#1F0B0B;--card:#fff;--line:#1F0B0B;--yellow:#FED967;--pink:#FDAEC7;--hot:#FC6B8B;--blue:#91D1FD;--cream:#FEF3D3;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1A0D0E;--fg:#FEF3D3;--card:#241214;--line:#FEF3D3}}
:root[data-theme="dark"]{--bg:#1A0D0E;--fg:#FEF3D3;--card:#241214;--line:#FEF3D3}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:500 14px/1.6 "DM Sans",system-ui,sans-serif}
button{font:inherit;color:inherit;cursor:pointer}
header{display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px;padding:12px 22px;border-bottom:3px solid var(--line);background:var(--bg)}
.logo{font:400 40px/1 "Bagel Fat One",cursive;color:var(--yellow);-webkit-text-stroke:3px var(--ink);paint-order:stroke fill;text-shadow:3px 3px 0 var(--hot);letter-spacing:.02em;margin-right:6px}
nav{display:flex;flex-wrap:wrap;gap:10px}
nav button{font:800 12px/1 Syne,sans-serif;letter-spacing:.06em;text-transform:uppercase;padding:8px 14px;border:2px solid var(--line);background:var(--card);transition:transform .15s,box-shadow .15s}
nav button:hover{transform:translate(-2px,-2px);box-shadow:3px 3px 0 var(--line)}
nav button.on{background:var(--yellow);color:var(--ink)}
.tools{margin-left:auto;display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.cart{display:flex;align-items:center;gap:6px;border:0;background:none;font:800 16px Syne,sans-serif;padding:0}
.soc{display:flex;gap:10px}.soc a{color:var(--fg);display:flex}
svg.i{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.view{display:none}.view.on{display:grid}
#home{grid-template-columns:1fr 1fr;min-height:calc(100svh - 100px)}
.left{padding:44px 42px 56px;display:flex;flex-direction:column;justify-content:center}
.about{position:relative;border:2px solid var(--line);background:var(--card);padding:18px 24px 30px;max-width:520px;margin:0 auto}
h1,h2{font:400 clamp(56px,8vw,96px)/.95 "Bagel Fat One",cursive;color:var(--yellow);-webkit-text-stroke:3px var(--ink);paint-order:stroke fill;text-shadow:4px 4px 0 var(--pink);margin:0 0 14px;transform:rotate(-2deg);transform-origin:left}
.about p{margin:0 0 12px;font-size:13px}
.mail{position:absolute;right:18px;bottom:-20px;transform:rotate(-5deg);font:800 14px Syne,sans-serif;letter-spacing:.06em;padding:6px 14px;border:2px solid var(--line);background:var(--pink);color:var(--ink);text-decoration:none;transition:transform .15s}
.mail:hover{transform:rotate(2deg) scale(1.06)}
.left .soc{max-width:520px;width:100%;margin:26px auto 0}
.right{position:relative;background:var(--blue);overflow:hidden;min-height:420px}
.right>svg{position:absolute;inset:0;width:100%;height:100%}
.cloud{position:absolute;height:38px;background:var(--cream);border-radius:40px}
.cloud::before,.cloud::after{content:"";position:absolute;background:inherit;border-radius:50%}
.cloud::before{width:46%;height:130%;left:14%;top:-55%}.cloud::after{width:36%;height:100%;right:14%;top:-35%}
.grid{position:absolute;top:0;right:0;width:76px;height:42%;border-left:2px solid var(--ink);background:linear-gradient(var(--ink) 2px,transparent 2px) 0 0/100% 38px,linear-gradient(90deg,var(--ink) 2px,transparent 2px) 0 0/38px 100%,#fff;opacity:.9}
.pg{padding:36px 28px 60px;max-width:1100px;margin:0 auto;width:100%}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:22px;margin-top:30px}
.card{border:2px solid var(--line);background:var(--card);display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s}
.card:hover{transform:translate(-3px,-3px);box-shadow:6px 6px 0 var(--line)}
.tile{height:150px;border-bottom:2px solid var(--line);display:grid;place-items:center;font:400 34px "Bagel Fat One",cursive;color:var(--ink);-webkit-text-stroke:0}
.cb{padding:14px;display:flex;flex-direction:column;gap:8px;flex:1}
.chip{align-self:flex-start;font:800 10px Syne,sans-serif;letter-spacing:.08em;text-transform:uppercase;border:2px solid var(--line);padding:2px 8px;background:var(--cream);color:var(--ink)}
.cb h3{margin:0;font:800 17px Syne,sans-serif}.cb p{margin:0;font-size:13px;flex:1}
.btn{font:800 12px Syne,sans-serif;letter-spacing:.06em;text-transform:uppercase;padding:8px 12px;border:2px solid var(--line);background:var(--yellow);color:var(--ink)}
.btn:hover{background:var(--pink)}
.lic{margin-top:30px;display:grid;gap:14px;max-width:640px}
.lic div{border:2px solid var(--line);background:var(--card);padding:12px 16px}
.lic b{font:800 13px Syne,sans-serif;text-transform:uppercase;letter-spacing:.06em}
dialog{border:2px solid var(--line);background:var(--card);color:var(--fg);max-width:480px;width:calc(100% - 32px);padding:24px;box-shadow:8px 8px 0 var(--hot)}
dialog::backdrop{background:rgba(31,11,11,.5)}
dialog h3{font:400 38px/1 "Bagel Fat One",cursive;margin:0 0 6px}
dialog dl{margin:14px 0;font-size:13px}dialog dt{font:800 11px Syne,sans-serif;text-transform:uppercase;letter-spacing:.08em;margin-top:8px}dialog dd{margin:0}
.row{display:flex;gap:10px;margin-top:16px}
footer{border-top:3px solid var(--line);padding:16px 22px;font:700 12px Syne,sans-serif;letter-spacing:.06em;text-transform:uppercase;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
@media (max-width:820px){#home{grid-template-columns:1fr}.left{padding:32px 18px 48px}.right{min-height:380px;order:-1}.tools{margin-left:0;flex-direction:row;align-items:center;gap:14px;width:100%;justify-content:space-between}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <div class="logo">MOKI</div>
  <nav id="nav">
    <button class="on" data-v="home">Home</button>
    <button data-v="projects">Projects</button>
    <button data-v="licensing">Licensing</button>
  </nav>
  <div class="tools">
    <button class="cart" id="cartBtn" aria-label="Free downloads"><svg class="i" viewBox="0 0 24 24"><path d="M3 9h18l-2 10H5L3 9zM8 9l3-5M16 9l-3-5"/></svg><span id="cnt">0</span></button>
    <div class="soc"><a href="#" aria-label="Instagram"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></svg></a><a href="#" aria-label="Link"><svg class="i" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></a></div>
  </div>
</header>

<main>
<section class="view on" id="home">
  <div class="left">
    <div class="about">
      <h1>ABOUT</h1>
      <p>MOKI is a creative design and product studio started by two co-founders with no budget, just skills, time and free tools.</p>
      <p>We make original things first: website designs and components, UI/UX concepts, app interfaces, reusable widgets, posters, stickers, illustrations and book covers. Then we give them away, with clear credit and licenses.</p>
      <p>Our look is playful, colourful and a little mischievous. Our plan is simple: create, publish, share, improve, repeat.</p>
      <p>Long term, MOKI wants to grow from digital design into physical products and hardware.</p>
      <a class="mail" href="mailto:hello@example.com">MAIL</a>
    </div>
    <div class="soc"><a href="#" aria-label="Instagram"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></svg></a><a href="#" aria-label="Link"><svg class="i" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></a></div>
  </div>
  <div class="right">
    <span class="cloud" style="left:6%;top:6%;width:120px"></span>
    <span class="cloud" style="left:34%;top:3%;width:80px"></span>
    <span class="cloud" style="left:8%;bottom:7%;width:100px"></span>
    <div class="grid"></div>
    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMid meet" role="img" aria-label="MOKI mascot">
<style>
  .char{transform-box:fill-box;transform-origin:50% 100%;animation:bob 3.2s ease-in-out infinite}
  @keyframes bob{0%,100%{transform:translateY(0) scale(1,1)}50%{transform:translateY(-10px) scale(.992,1.012)}}
  .look{animation:look 6s ease-in-out infinite}
  @keyframes look{0%,18%{transform:translate(0,0)}24%,40%{transform:translate(-9px,2px)}46%,62%{transform:translate(9px,-2px)}70%,100%{transform:translate(0,0)}}
  .blink{transform-box:fill-box;transform-origin:50% 50%;animation:blink 4.5s infinite}
  @keyframes blink{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.08)}}
  .rise{animation:rise 4s ease-out infinite;opacity:0}
  @keyframes rise{0%{transform:translateY(30px) scale(.4);opacity:0}15%{opacity:1}100%{transform:translateY(-90px) scale(1);opacity:0}}
  .twinkle{transform-box:fill-box;transform-origin:50% 50%;animation:twinkle 2.4s ease-in-out infinite}
  @keyframes twinkle{0%,100%{transform:scale(.4) rotate(0);opacity:.2}50%{transform:scale(1.15) rotate(25deg);opacity:1}}
  .pulse{transform-box:fill-box;transform-origin:50% 50%;animation:pulse 3s ease-in-out infinite}
  @keyframes pulse{0%,100%{transform:scale(.4);opacity:.3}50%{transform:scale(1);opacity:1}}
  @media (prefers-reduced-motion:reduce){*{animation:none!important}.rise{opacity:1}}
</style>

